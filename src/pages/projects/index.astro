---
import { Image } from 'astro:assets'

import { Button, Collapse, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.webp'
import KeyIcon from '@/assets/icons/key.svg'
import wechat from '@/assets/wechat-qrcode.webp'

const headings = [
  { depth: 2, slug: 'theme', text: 'Theme' },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'learnings', text: 'Learnings' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'gpg-signature', text: 'GPG Signature' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Nakanomk'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    If you think it would be useful or interesting to collaborate on a project, you can donate to
    support my work or contact me to discuss a project.
  </p>
  <Button title='Checkout sponsorship' class='w-fit' href='#sponsorship'>
    <Icon class='size-5' name='receive-money' slot='before' />
  </Button>

  <h2 id='theme'>Blog</h2>
  <ProjectSection
    projects={[
      {
        name: '🚀 Nknsblog Astro Rebuild',
        description: 'Current version of my blog, built with Astro framework',
        links: [
          { type: 'github', href: 'https://github.com/Nakanomk/Nknsblog_astro_rebuild' },
          { type: 'site', href: 'https://nkns.cc' }
        ]
      },
      {
        name: '📚 Nkns-hexo-blog',
        description: 'A previous version of my blog built with Hexo',
        links: [
          { type: 'github', href: 'https://github.com/Nakanomk/Nakanomk.github.io' },
          { type: 'site', href: 'https://nakanomk.github.io/' },
          {
            type: 'doc',
            href: 'https://www.bilibili.com/video/BV1UT42167xb'
          }
        ]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🐱 Neko-Game',
        description: 'Neko Neko Meow Meow — a fun game project',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Neko-Game' }]
      },
      {
        name: '⏰ WadwaitaUp',
        description: 'An adwaita-designed version of WakeUp with better experience',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/WadwaitaUp' }]
      },
      {
        name: '🐧 bilibili-linux',
        description: '哔哩哔哩官方客户端 Linux 移植版，支持漫游',
        links: [{ type: 'github', href: 'https://github.com/msojocs/bilibili-linux' }]
      },
      {
        name: '📝 HUST-Course-Helper',
        description: '华科课程平台刷题助手',
        links: [{ type: 'github', href: 'https://github.com/Ozqi/HUST-Course-Helper' }]
      }
    ]}
  />
  <Collapse title='Some old projects'>
    <ProjectSection
      projects={[
        {
          name: '📦 my-first-package',
          description: 'My first npm package experiment',
          links: [{ type: 'github', href: 'https://github.com/Nakanomk/my-first-package' }]
        }
      ]}
    />
  </Collapse>

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'Hust-java',
        description: 'Java course files and assignments.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-java' }]
      },
      {
        name: 'Hust-java-lab',
        description: 'Java lab coursework.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-java-lab' }]
      },
      {
        name: 'Hust-ML',
        description: 'Machine Learning course materials.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-ML' }]
      },
      {
        name: 'Hust-Verilog',
        description: 'Verilog HDL coursework and experiments.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-Verilog' }]
      },
      {
        name: 'Hust-DB',
        description: 'Database course materials.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-DB' }]
      },
      {
        name: 'Hust-LCSD',
        description: 'Logic & Computer System Design coursework.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-LCSD' }]
      },
      {
        name: 'Hust-Mao',
        description: 'Maoism course materials.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/Hust-Mao' }]
      }
    ]}
  />

  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: '📖 hustIST2402',
        description: 'Documents share for IST2402 class.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/hustIST2402' }]
      },
      {
        name: '🔧 dotfiles',
        description: 'Backup my personal config files.',
        links: [{ type: 'github', href: 'https://github.com/Nakanomk/dotfiles' }]
      }
    ]}
  />

  <!-- gpg signature -->
  <h2 id='gpg-signature'>GPG Signature</h2>
  <p>
    You can verify the authenticity of the files I signed by checking the GPG signature. My GPG key
    fingerprint is <code>65EFE79A 85689C96 B3BABBCB 47745EB7 512F521B</code>, and you can find it on
    the OpenPGP key servers or download from below.
  </p>
  <Button
    href='https://keys.openpgp.org/search?q=47745EB7512F521B'
    title='Checkout my key'
    target='_blank'
  >
    <KeyIcon class='size-5' slot='before' />
  </Button>

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>Please leave a message or contact me proactively after sponsorship.</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>Thanks to the following sponsors(Not real-time updated):</p>
  <Sponsors sponsors={[{ name: 'N/A', amount: '0', date: '2026/06/09' }]} />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
