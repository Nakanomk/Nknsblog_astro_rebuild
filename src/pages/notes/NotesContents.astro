---
import { getBlogCollection } from 'astro-pure/server'
import { cn } from 'astro-pure/utils'

import { groupNotesByCategory, type NotesEntry } from './shared'

export const prerender = true
export const partial = true

const notesCollection = (await getBlogCollection('notes')) as NotesEntry[]
const noteSections = groupNotesByCategory(notesCollection)

type Props = {
  title?: boolean
  class?: string
  /** The current note's id (e.g. "dm/set-theory") — when set, the entire category
   *  section that contains this note is moved to the top of the list so readers
   *  can immediately see which book/notes collection they are browsing. */
  currentNoteId?: string
}

const { title = true, class: className, currentNoteId, ...props } = Astro.props

// When we are on a note detail page, promote the category that contains the
// current note to the very top so the reader can see their current location
// in the sidebar / bottom list immediately.
function promoteCurrentCategory<T extends { id: string }>(
  sections: { id: string; title: string; docs: T[] }[],
  currentId: string
): { id: string; title: string; docs: T[] }[] {
  const currentCategoryId = currentId.split('/')[0]
  const idx = sections.findIndex((s) => s.id === currentCategoryId)
  if (idx <= 0) return sections
  const section = sections[idx]
  return [section, ...sections.slice(0, idx), ...sections.slice(idx + 1)]
}

const orderedSections = currentNoteId
  ? promoteCurrentCategory(noteSections, currentNoteId)
  : noteSections
---

<notes-toc class={cn('not-prose', className)} {...props}>
  {title && <h2 class='text-foreground font-semibold'>NOTES</h2>}
  <ul class='mt-4 flex flex-col gap-y-5'>
    {
      orderedSections.map(({ title, docs }) => (
          <li>
            <h3 class='text-muted-foreground text-xs tracking-widest uppercase'>{title}</h3>
            <ul class='mt-2 flex flex-col'>
              {docs.map((doc) => (
                <li class='notes-item flex relative ms-2 px-3 py-1 text-foreground/75 transition-all rounded-2xl'>
                  <a class='flex-1 hover:text-foreground' href={`/notes/${doc.id}`}>
                    {doc.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )
      )
    }
  </ul>
</notes-toc>

<style>
  notes-toc .notes-item::before {
    content: '';
    display: block;
    position: absolute;
    top: 5%;
    bottom: 5%;
    left: -0.5rem;
    width: 2px;
    background-color: hsl(var(--input) / var(--un-bg-opacity));
  }

  notes-toc :global(.notes-item.notes-hl) {
    background-color: hsl(var(--muted) / var(--un-bg-opacity));
    font-weight: 500;
    & a {
      color: hsl(var(--primary) / var(--un-text-opacity));
    }

    &::before {
      background-color: hsl(var(--primary) / var(--un-bg-opacity));
    }
  }
</style>

<script>
  class NotesTOC extends HTMLElement {
    link: string = ''

    constructor() {
      super()

      this.link = window.location.pathname
    }

    connectedCallback() {
      const links = this.querySelectorAll('a')
      links.forEach((link) => {
        if (link.getAttribute('href') === this.link) {
          link.parentElement?.classList.add('notes-hl')
        }
      })
    }
  }

  customElements.define('notes-toc', NotesTOC)
</script>
